{
  "name": "@insiderflow/db",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle ORM schema and Postgres client for InsiderFlow",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "keepalive": "node scripts/keepalive.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "app-role": "node scripts/app-role.mjs",
    "seed": "node scripts/seed.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
