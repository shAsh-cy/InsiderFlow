{
  "name": "insiderflow",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, real-time, multi-market insider-trading tracker",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @insiderflow/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:changelog": "node scripts/lint-changelog.mjs",
    "lint:e2e-locators": "node scripts/lint-e2e-locators.mjs",
    "// test": "Sequential: four packages spin up PGlite (Postgres in WASM), and running those WASM heaps concurrently exhausts memory on a 2-core runner (VirtualAlloc/OOM). Serial is slower but deterministic.",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "pnpm --filter @insiderflow/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @insiderflow/db db:generate",
    "db:migrate": "pnpm --filter @insiderflow/db db:migrate",
    "db:push": "pnpm --filter @insiderflow/db db:push",
    "db:studio": "pnpm --filter @insiderflow/db db:studio",
    "db:bootstrap": "pnpm --filter @insiderflow/db bootstrap",
    "db:app-role": "pnpm --filter @insiderflow/db app-role",
    "seed": "pnpm --filter @insiderflow/db seed",
    "analytics:nightly": "pnpm --filter @insiderflow/analytics nightly",
    "ops:check": "pnpm --filter @insiderflow/analytics ops-check",
    "backfill": "pnpm --filter @insiderflow/edgar-worker backfill",
    "india:ingest": "pnpm --filter @insiderflow/india-local ingest",
    "smoke:alert-insert": "node packages/db/scripts/smoke-alert-insert.mjs",
    "prepare": "husky",
    "lint:e2e-assertions": "node scripts/lint-e2e-assertions.mjs",
    "lint:api-schemas": "node scripts/lint-api-schemas.mjs",
    "lint:client-bundle": "node scripts/lint-client-bundle.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.6.0",
    "typescript-eslint": "^8.35.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,yml,yaml}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23",
      "nanoid": "^3.3.17",
      "sharp": "^0.35.2",
      "undici": "^7.29.0",
      "esbuild": "^0.25.0"
    }
  }
}
