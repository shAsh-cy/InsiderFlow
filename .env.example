# ── Database ────────────────────────────────────────────────────────────────
# Local: docker compose up -d  →  postgres://postgres:postgres@localhost:5433/insiderflow
# Prod:  Supabase → Project Settings → Database → Connection string (use the
#        "Transaction" pooler URL for serverless/edge runtimes)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/insiderflow

# ── Supabase (free tier) ────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service-role key: server-side only. NEVER expose to the browser.
SUPABASE_SERVICE_KEY=

# ── SEC EDGAR ───────────────────────────────────────────────────────────────
# SEC fair-access policy REQUIRES a descriptive User-Agent identifying you:
# https://www.sec.gov/os/accessing-edgar-data
EDGAR_USER_AGENT="InsiderFlow/0.1 (your-email@example.com)"

# ── Secondary market-data sources (all optional, all free-tier) ────────────
# Finnhub (60 calls/min): insider transactions + insider-sentiment MSPR
FINNHUB_API_KEY=
# Financial Modeling Prep (~250 calls/day): insider trading endpoint
FMP_API_KEY=
# Symbols the symbol-scoped sources (Finnhub/FMP) sync, comma-separated
WATCHLIST_SYMBOLS=AAPL,MSFT,NVDA
# NSE/BSE disclosures are licensing-restricted: point this at a feed you are
# licensed to use (see the IndiaAdapter legal note). Leave empty to disable.
INDIA_FEED_URL=
# OPTIONAL local scrape runner (pnpm india:ingest) — OFF by default. Read
# ingestion/india-local/README.md for the ToS/IT Act risk summary before
# enabling. The hosted reference deployment never runs it.
ENABLE_INDIA_INGEST=false
# FX (Frankfurter/ECB) and prices (Stooq) need no API keys.

# ── Auth (Supabase — sessions only; app data stays in DATABASE_URL) ────────
# Leave empty to run InsiderFlow as a fully public, read-only site.
# See docs/auth.md for the dev/prod story and why sessions and data are split.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Alerts ──────────────────────────────────────────────────────────────────
# Public origin used in alert email links.
SITE_URL=http://localhost:3000
# Telegram is the PRIMARY channel: free, unlimited, real-time.
# Token from @BotFather; username without the @ (for the /start deep link).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Shared secret for the Telegram webhook (setWebhook?secret_token=...).
TELEGRAM_WEBHOOK_SECRET=
# Resend (email). Free tier is 100/day, 3,000/mo — the binding cap, so email
# batches into one daily digest per user unless a rule opts into instant.
RESEND_API_KEY=
RESEND_FROM="InsiderFlow Alerts <alerts@yourdomain.com>"
