# InsiderFlow environment.
#
# ONLY TWO ARE REQUIRED: DATABASE_URL and EDGAR_USER_AGENT. Everything else is
# optional and has a documented fallback — with none of it set, the app runs as
# a fully public, read-only site with SEC EDGAR data and no accounts.
#
# The "used by" column matters: these processes are deployed separately, so a
# variable set in the wrong place silently does nothing.
#
#   web       → apps/web on Vercel (Project Settings → Environment Variables)
#   worker    → Cloudflare Worker (`wrangler secret put NAME`, or .dev.vars locally)
#   actions   → GitHub Actions (Settings → Secrets and variables → Actions)
#   local     → this file / your shell, for scripts and docker compose
#
# NEVER COMMIT REAL VALUES. Rotate anything that has been in a chat, a commit,
# a screenshot, or a shared terminal — treat it as burned the moment it is
# visible outside a secret store.

# ═══════════════════════════════════════════════════════════════════════════
# REQUIRED
# ═══════════════════════════════════════════════════════════════════════════

# Postgres connection.            used by: web, worker, actions, local
# Local:      docker compose up -d  →  the URL below
# Production: Supabase → Settings → Database → Connection string →
#             **Transaction pooler** (port 6543), NOT the direct connection.
#             Serverless opens many short-lived connections; the direct port
#             exhausts its limit. All clients run pooler-safe (prepare:false).
#
# THIS IS THE ADMIN CONNECTION. It runs migrations and the ingestion/analytics
# jobs, which legitimately read every user's rules. The WEB APP must NOT use
# it — see APP_DATABASE_URL below.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/insiderflow

# The web app's connection: the `insiderflow_app` role, which has NOBYPASSRLS
# so row-level security on the four user tables actually applies to every
# request it makes. Create or rotate it with:
#
#   APP_DB_PASSWORD='<generated>' pnpm db:app-role
#
# Unset = the web app falls back to DATABASE_URL, which on most deployments is
# a superuser and therefore ignores every policy. `pnpm db:bootstrap` FAILS
# rather than passing quietly when it cannot prove enforcement.
#                                              used by: web, local (bootstrap)
APP_DATABASE_URL=postgres://insiderflow_app:insiderflow_local_dev@localhost:5433/insiderflow

# Password for the role above; read only by `pnpm db:app-role`. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# used by: local (setup), actions (bootstrap)
APP_DB_PASSWORD=insiderflow_local_dev

# SEC fair-access policy REQUIRES a descriptive User-Agent with a real contact
# address, and caps automated traffic at 10 req/s. Using a fake address risks
# your deployment's IP being blocked.   used by: worker, actions
# https://www.sec.gov/os/accessing-edgar-data
EDGAR_USER_AGENT="InsiderFlow/0.1 (your-email@example.com)"

# ═══════════════════════════════════════════════════════════════════════════
# WEB APP
# ═══════════════════════════════════════════════════════════════════════════

# Public origin. Used in alert email links and RSS self-references.
# Default: https://insiderflow.dev            used by: web, worker, actions
SITE_URL=http://localhost:3000

# Public API rate limits. Default: 60/min per IP, 600/min with an API key.
# The names must match what the code reads — an audit found this documented as
# RATE_LIMIT_KEYED_PER_MIN, which silently did nothing.   used by: web
# RATE_LIMIT_PUBLIC_PER_MIN=60
# RATE_LIMIT_APIKEY_PER_MIN=600

# Concurrent SSE connections on /api/stream. The rate limits above bound how
# OFTEN a client may open a stream; these bound how many it may hold, because
# each one occupies a serverless function for ~25s. Per instance (like the
# in-memory rate limiter), so the real global figure is (value x instances).
# Defaults: 4 per client, 200 total.           used by: web
# SSE_MAX_CONCURRENT_PER_IP=4
# SSE_MAX_CONCURRENT=200

# Comma-separated API keys that get the higher limit. Unset = no keyed tier.
# used by: web
# API_KEYS=

# Distributed rate limiting. Unset = in-memory per instance, which is fine for
# a single region but means the real limit is (configured × instances).
# Free tier ≈ 5,000 API requests/day. See SCALING.md.   used by: web
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ═══════════════════════════════════════════════════════════════════════════
# AUTH — optional. Unset = public read-only site with no sign-in chrome.
# ═══════════════════════════════════════════════════════════════════════════

# Supabase holds SESSIONS ONLY; all app data lives in DATABASE_URL.
# Supabase → Settings → API.                  used by: web
# Production also needs the deployed URL added to Supabase Auth → URL
# Configuration (Site URL + redirect allow-list). See docs/quickstart.md.
#
# BUILD TIME, not just run time. Server code reads process.env per request, but
# the BROWSER bundle resolves NEXT_PUBLIC_* when Next compiles it — so a value
# supplied only at run time yields a page that renders the sign-in button on
# the server and removes it on hydration. Vercel supplies them to the build
# automatically; `docker compose` passes them to `build.args` for the same
# reason. Neither is a secret (docs/security.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. NEVER expose to the browser, never prefix with NEXT_PUBLIC.
# Not required by any current code path.      used by: local (admin scripts)
# SUPABASE_SERVICE_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# ALERTS — optional. Unset = alerts are logged but never delivered.
# ═══════════════════════════════════════════════════════════════════════════

# Telegram is the PRIMARY channel: free, unlimited, real-time.
# Token from @BotFather. Use a FRESH token for production — never the one you
# tested with locally (@BotFather → /revoke, then /token).
# used by: worker, web (webhook), actions (digest backstop, ops alerts)
TELEGRAM_BOT_TOKEN=

# Bot username WITHOUT the @, for the `/start <token>` deep link in Settings.
# used by: web
TELEGRAM_BOT_USERNAME=

# Shared secret for the Telegram webhook; the webhook rejects traffic without
# it. Set with setWebhook?secret_token=...    used by: web
TELEGRAM_WEBHOOK_SECRET=

# Chat id that receives ops alerts when a background job falls behind.
# Separate from user alerts. Unset = ops-check logs instead of sending.
# used by: actions
OPS_TELEGRAM_CHAT_ID=

# Resend (email). Free tier is 100/day, 3,000/month — the binding constraint
# on the whole alerting system, which is why email batches into ONE digest per
# user per day. Telegram is not capped, so a Telegram-only rule defaults to
# instant.                                    used by: worker, actions
RESEND_API_KEY=
RESEND_FROM="InsiderFlow Alerts <alerts@yourdomain.com>"

# How old an event may be and still fire an INSTANT alert (minutes).
# Default: 60. Older matches route to the digest with defer_reason='stale', so
# a cursor reset, a backfill, or a replay cannot push a month of historical
# trades as if it were breaking news.         used by: worker
ALERT_INSTANT_MAX_AGE=60

# ═══════════════════════════════════════════════════════════════════════════
# ANALYTICS
# ═══════════════════════════════════════════════════════════════════════════

# Where cluster membership is read from.      used by: web, worker
#   flags (default) — precomputed cluster_flags, maintained by the ingest cron
#   sql             — the query-time GROUP BY fallback, for self-hosters
#                     running only the web app with no cron
# Both paths are asserted equal by a parity test on labelled fixtures.
INSIDERFLOW_CLUSTER_SOURCE=flags

# Show synthetic ZZ* fixtures on AGGREGATE surfaces (heatmap, leaderboard,
# anomaly rankings). Default: false.          used by: web
# Trade-level screens and the alert scanner always include ZZ* rows — that is
# the supported smoke-test path. This flag only governs aggregates, which are
# presented as a picture of the market and so must not contain fabricated data.
# docker-compose sets it to true so a seeded local stack shows a working
# product; the UI labels itself whenever it is on. NEVER set it in production.
# INSIDERFLOW_SHOW_SYNTHETIC=false

# Congressional PTR sources.                  used by: actions
# The bundled defaults (house/senate-stock-watcher) went offline — they return
# HTTP 403 as of 2026-08-04. Set these to any source you have the rights to
# use. Expected shape and the swap procedure: docs/politicians.md.
# HOUSE_PTR_URL=
# SENATE_PTR_URL=

# ═══════════════════════════════════════════════════════════════════════════
# SECONDARY MARKET-DATA SOURCES — all optional, all free-tier
# ═══════════════════════════════════════════════════════════════════════════

# Finnhub (60 calls/min): insider transactions + insider-sentiment MSPR.
# used by: worker
FINNHUB_API_KEY=

# Financial Modeling Prep (~250 calls/day): insider trading endpoint.
# used by: worker
FMP_API_KEY=

# Symbols the symbol-scoped sources (Finnhub/FMP) sync, comma-separated.
# Unset = those adapters stay idle even with a key set.   used by: worker
WATCHLIST_SYMBOLS=AAPL,MSFT,NVDA

# FX (Frankfurter/ECB) and daily prices (Stooq) need no API keys.

# ═══════════════════════════════════════════════════════════════════════════
# INDIA — self-host only. The hosted reference deployment ships without this.
# ═══════════════════════════════════════════════════════════════════════════

# LICENSED feed of NSE/BSE disclosures. This is the recommended path and the
# only one used by the hosted deployment. Ingests on the normal cron.
# used by: worker
INDIA_FEED_URL=

# Optional LOCAL SCRAPE runner (`pnpm india:ingest`) — OFF by default.
# NSE/BSE terms restrict automated access, and India IT Act §43 creates civil
# liability for unauthorised access. Read ingestion/india-local/README.md in
# full before setting this to true. Requires a residential IP; exchanges
# soft-fail to empty data from datacenter ranges.         used by: local
ENABLE_INDIA_INGEST=false

# ═══════════════════════════════════════════════════════════════════════════
# DOCKER / LOCAL STACK
# ═══════════════════════════════════════════════════════════════════════════

# Seconds between ingest ticks in the docker `ingest` service. Default: 60.
# INGEST_INTERVAL_SECONDS=60

# Cap per run; keeps a Worker invocation under the free-tier subrequest limit.
# Default: 25.                                used by: worker, local
# MAX_FILINGS_PER_RUN=25

# How many 100-item EDGAR feed pages DISCOVERY walks back per form each run.
# Default: 3. Discovery only queues refs — the cap above governs how many are
# actually fetched — so raising this costs 1 subrequest per extra page and
# buys deeper reach into a burst. Both share the Worker's 50-subrequest
# budget: forms x pages + MAX_FILINGS_PER_RUN must stay under it.
# used by: worker, local
# MAX_DISCOVERY_PAGES=3

# Set SEED=0 to migrate without seeding synthetic data in docker compose.
# SEED=1

# ═══════════════════════════════════════════════════════════════════════════
# TESTS — only ever set locally or in CI
# ═══════════════════════════════════════════════════════════════════════════

# Run Playwright against an ALREADY-RUNNING instance instead of letting it
# start its own dev server. Point it at the docker stack to test the same
# artefact a contributor gets:
#   PLAYWRIGHT_BASE_URL=http://localhost:3000 pnpm --filter @insiderflow/web e2e
# used by: local, actions
# PLAYWRIGHT_BASE_URL=

# Name of the RLS-bound application role, if you renamed it from the default
# `insiderflow_app`. Read only by `pnpm db:app-role`.   used by: local (setup)
# APP_DB_ROLE=insiderflow_app

# ── Bot protection (Cloudflare Turnstile) ─────────────────────────────
#
# OPTIONAL, and off by default: unset means the widget does not render, no
# token is sent, and sign-in works normally. That is the state of every
# fresh clone and of CI.
#
# Only the SITE key belongs here — it is public and ships in the client
# bundle by design. The SECRET key is deliberately NOT an entry in this
# file: it goes into the Supabase dashboard (Authentication → Attack
# Protection), because Supabase is what verifies the token. A variable
# here would only invite somebody to put the secret in a place this
# application can read, which is exactly where it should not be.
#
# Enabling it also opens `frame-src https://challenges.cloudflare.com` in
# the CSP, and only then — see apps/web/src/lib/security/csp.ts.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
