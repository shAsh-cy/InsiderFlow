{
  "name": "@insiderflow/edgar-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that ingests SEC EDGAR ownership filings (Forms 3/4/5) on a 1-minute cron",
  "type": "module",
  "exports": {
    "./pipeline": "./src/pipeline.ts",
    "./http": "./src/http.ts",
    "./enrich": "./src/enrich.ts"
  },
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "backfill": "tsx scripts/backfill.ts",
    "ingest:loop": "tsx scripts/loop.ts",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@insiderflow/alerts": "workspace:*",
    "@insiderflow/analytics": "workspace:*",
    "@insiderflow/core": "workspace:*",
    "@insiderflow/core": "workspace:*",
    "@insiderflow/db": "workspace:*",
    "drizzle-orm": "^0.44.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.20.0"
  }
}
